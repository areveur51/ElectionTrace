# Copy to .env (optional). Defaults work for local setup.
PORT=5200
HOST=0.0.0.0

# Directory of *.geojson.gz / *.geojson precinct files
MEDIA_DIR=./media

# Written index (safe to delete; rebuilt on next start)
DATA_DIR=./data

# Optional TLS (paths only — never commit the key file)
# HTTPS_KEY=./tls/server.key
# HTTPS_CERT=./tls/server.crt

# Optional night-file directory (defaults to media/nyt-election-data or media/sample/…)
# NYT_STATES_DIR=./media/nyt-election-data

# Optional Postgres. JSONL under DATA_DIR is the default. Use your own URL; never commit .env.
# DATABASE_URL=postgres://USER:PASS@127.0.0.1:5432/electiontrace
